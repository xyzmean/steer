// steer for the Android platform build (DerpFest 16.2 / lineage-23.2).
//
// Two builds of the same engine, as on the router: the base one (ten sources, the Makefile's
// build/steer target) and the extended one — the same sources plus src/tunnel and src/proto (VLESS/Reality
// client, xsteer, tgws) and mbedtls. The owner chose the extended build for the phone from the
// first version, so it is the module named "steer" that vendor/der/config/der.mk installs; the
// base build stays as steer_base for trees without mbedtls.
//
// Both are compiled with -DSTEER_DEFAULT_PLATFORM=android. The platform is chosen at run time
// (src/platform/platform.c) and the code of both platforms is in every binary; the define only
// makes the phone the default, so the binary behaves as the phone wherever it runs (mark field
// above netd's bits, ip rule priorities below netd's ladder, directories under
// /data/misc/steer, /dev/tun — see src/platform/android.c). The engine calls `nft -f`, `ip`
// and `iptables` as external programs and finds them through init's default PATH, which
// includes /system_ext/bin (nft) and /system/bin.
//
// Installed in system_ext/bin/der/ rather than system_ext/bin/: every domain may list
// /system_ext/bin (system_file:dir r_dir_perms), and the directory der/ carries its own SELinux
// label that apps cannot search, so neither the name nor the attributes of the binary are
// visible to them. See vendor/der/sepolicy.

cc_defaults {
    name: "steer_defaults",
    system_ext_specific: true,
    relative_install_path: "der",
    stem: "steer",
    srcs: [
        "src/lib/run.c",
        "src/lib/jsonw.c",
        "src/lib/evline.c",
        "src/lib/err.c",
        "src/compile/groups.c",
        "src/compile/generate.c",
        "src/compile/ir.c",
        "src/compile/print.c",
        "src/compile/legacy.c",
        "src/daemon/fwcheck.c",
        "src/daemon/apply.c",
        "src/daemon/status.c",
        "src/daemon/nftquery.c",
        "src/daemon/diag.c",
        "src/daemon/explain.c",
        "src/daemon/supervise.c",
        "src/daemon/watch.c",
        "src/daemon/main.c",
        "src/lib/jsonr.c",
        "src/lib/tmpfile.c",
        "src/platform/platform.c",
        "src/platform/openwrt.c",
        "src/platform/android.c",
        "src/model/parse.c",
        "src/model/registry.c",
        "src/model/probe.c",
        "src/compile/nftcompat.c",
        "src/lib/sindex.c",
        "src/lib/nftnl.c",
        "src/lib/ctnl.c",
        "src/dnsd/rules.c",
        "src/dnsd/wire.c",
        "src/dnsd/origdst.c",
        "src/dnsd/fakeip.c",
        "src/dnsd/table.c",
        "src/dnsd/tabfmt.c",
        "src/dnsd/dlog.c",
        "src/dnsd/proxy.c",
        "src/dnsd/main.c",
        "src/daemon/failover.c",
        "src/tools/aggregate.c",
        "src/proto/obfs/obfs.c",
        "src/cli/cli.c",
        "src/tools/srs.c",
        "src/tools/puff.c",
        "src/tools/hwid.c",
        "src/daemon/ctl.c",
        "src/daemon/conns.c",
        "src/daemon/loop.c",
        "src/daemon/state.c",
        "src/daemon/watchd.c",
        "src/kinds/kind.c",
        "src/kinds/direct.c",
        "src/kinds/interface.c",
        "src/kinds/zapret.c",
        "src/kinds/tgws.c",
        "src/kinds/awg.c",
    ],
    // Каталоги слоёв — те же, что INC_DIRS в build/sources.mk (сверяет tests/buildmatch.sh).
    local_include_dirs: [
        "src/lib",
        "src/model",
        "src/platform",
        "src/compile",
        "src/daemon",
        "src/kinds",
        "src/cli",
        "src/dnsd",
        "src/tools",
        "src/proto/obfs",
        "src/tunnel",
        "src/proto/tls",
        "src/proto/vless",
        "src/proto/xsteer",
        "src/proto/tgws",
    ],
    cflags: [
        "-DSTEER_DEFAULT_PLATFORM=android",
        // Keep in step with VERSION (build.sh and the Makefile read it from
        // there; Soong cannot read a file into a define).
        "-DSTEER_VERSION=\"1.5.8\"",
    ],
    // No binary with steer's name should linger in a symbol table either.
    strip: {
        all: true,
    },
}

// Not installable: both modules would be /system_ext/bin/der/steer, and Kati rejects two
// install rules for one path ("overriding commands for target") for EVERY declared module,
// not only for those in PRODUCT_PACKAGES. Still buildable by name (m steer_base).
cc_binary {
    name: "steer_base",
    defaults: ["steer_defaults"],
    installable: false,
}

// mbedtls with the engine's own configuration (src/proto/tls/steer_mbedtls_config.h): the sources
// come from external/der-mbedtls, the configuration from here, because in mbedtls the config
// header is seen by every .c and must be the one the engine's headers are compiled with.
cc_library_static {
    name: "libsteer_mbedtls",
    srcs: [":libmbedtls_der_srcs"],
    header_libs: ["libmbedtls_der_headers"],
    export_header_lib_headers: ["libmbedtls_der_headers"],
    local_include_dirs: ["src/proto/tls"],
    cflags: ["-DMBEDTLS_CONFIG_FILE=\"steer_mbedtls_config.h\""],
}

cc_binary {
    name: "steer",
    defaults: ["steer_defaults"],
    // The router role of build/build-ext.sh: XS_COMMON + EXT_ROUTER.
    srcs: [
        "src/proto/xsteer/xswire.c",
        "src/proto/xsteer/xsconf.c",
        "src/proto/xsteer/xslink.c",
        "src/proto/xsteer/xsroute.c",
        "src/proto/tls/chello.c",
        "src/proto/xsteer/xshake.c",
        "src/proto/xsteer/xsconn.c",
        "src/proto/xsteer/xsstream.c",
        "src/proto/xsteer/xsepoch.c",
        "src/proto/tls/tls13.c",
        "src/proto/tls/certverify.c",
        "src/proto/tls/reality.c",
        "src/tunnel/tun.c",
        "src/proto/tls/h2.c",
        "src/proto/xsteer/xsadmin.c",
        "src/proto/vless/sub.c",
        "src/proto/vless/vless_proto.c",
        "src/proto/vless/vision.c",
        "src/proto/vless/client.c",
        "src/tunnel/tunnel.c",
        "src/tunnel/rtx.c",
        "src/proto/xsteer/xsclient.c",
        "src/proto/vless/subfetch.c",
        "src/proto/tgws/tgws.c",
        "src/proto/tls/tlsprobe.c",
        // Kinds of the full package (KINDS_EXT_SRC in build/sources.mk); without them the
        // registry answers "requires steer-extended" — see src/kinds/kind.c.
        "src/kinds/vless.c",
        "src/kinds/xsteer.c",
    ],
    cflags: [
        "-DSTEER_EXTENDED",
        "-DMBEDTLS_CONFIG_FILE=\"steer_mbedtls_config.h\"",
        // Soong builds this project with -Werror, and a comment in src/proto/tls/certverify.c
        // contains "*val/*val_n" (-Wcomment). That file is protected from edits, so the
        // warning is turned off here instead of being fixed there.
        "-Wno-comment",
    ],
    static_libs: ["libsteer_mbedtls"],
}
