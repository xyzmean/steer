# args: apply --dry-run --spec TMP/mac.json --state-dir TMP/state-mac
# exit: 0
table inet steer {
    set vpn_ip_c0 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24, 198.51.100.5 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        ether saddr { a4:83:e7:2c:11:0f } ip daddr @vpn_ip_c0 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:vpn_ip_c0"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        ether daddr { a4:83:e7:2c:11:0f } ip saddr @vpn_ip_c0 counter comment "steer-down:vpn_ip_c0"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "br-lan" udp dport 53 counter redirect to :5300
        iifname "br-lan" tcp dport 53 counter redirect to :5300
    }
}
