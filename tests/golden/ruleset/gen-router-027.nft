# args: apply --dry-run --spec TMP/threedom.json --state-dir TMP/state-td
# exit: 0
# stderr: steer[warn] channel d2: mode=realip уходит из движка — переведите канал на fakeip; сейчас режим ещё работает
table inet steer {
    set vpn_dom {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    set vpn_dom_c0r {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    set vpn_dom_c1 {
        type ipv4_addr
        flags interval,timeout
        auto-merge
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        ip saddr { 192.168.1.0/24 } ip daddr @vpn_dom meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:vpn_dom"
        ip saddr { 192.168.1.0/24 } ip daddr @vpn_dom_c0r meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:vpn_dom_c0r"
        ip saddr { 192.168.1.9 } ip daddr @vpn_dom_c1 meta mark set mark and 0xf00fffff or 0x40100000 ct mark set mark counter return comment "steer:vpn_dom_c1"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        ip daddr { 192.168.1.0/24 } ip saddr @vpn_dom counter comment "steer-down:vpn_dom"
        ip daddr { 192.168.1.0/24 } ip saddr @vpn_dom_c0r counter comment "steer-down:vpn_dom_c0r"
        ip daddr { 192.168.1.9 } ip saddr @vpn_dom_c1 counter comment "steer-down:vpn_dom_c1"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat; policy accept;
        ip saddr 192.168.1.0/24 udp dport 53 counter redirect to :5300
        meta nfproto ipv6 iifname "br-lan" udp dport 53 counter redirect to :5300
        ip saddr 192.168.1.0/24 tcp dport 53 counter redirect to :5300
        meta nfproto ipv6 iifname "br-lan" tcp dport 53 counter redirect to :5300
    }

    map fakeip {
        type ipv4_addr : ipv4_addr;
    }
    chain prerouting_dnat {
        type nat hook prerouting priority dstnat; policy accept;
        ip daddr 198.18.0.0/15 counter dnat ip to ip daddr map @fakeip
    }
}
