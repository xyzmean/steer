# args: apply --dry-run --spec TMP/tgws.json --state-dir TMP/state-t
# exit: 0
table inet steer {
    set tg_ip {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24, 198.51.100.5 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        iifname "br-lan" ip daddr @tg_ip meta mark set mark and 0xf00fffff or 0x40100000 counter return comment "steer:tg_ip"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
        oifname "br-lan" ip saddr @tg_ip counter comment "steer-down:tg_ip"
    }

    chain tgws_redirect {
        type nat hook prerouting priority dstnat + 1; policy accept;
        meta mark and 0x0ff00000 == 0x00100000 tcp dport { 443, 80, 5222 } counter redirect to :8480 comment "steer:tgws:tg"
    }
    chain prerouting_dns {
        type nat hook prerouting priority dstnat; policy accept;
        iifname "br-lan" udp dport 53 counter redirect to :5300
        iifname "br-lan" tcp dport 53 counter redirect to :5300
    }
}
