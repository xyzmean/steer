# args: apply --dry-run --spec TMP/local.json --state-dir TMP/state
# exit: 0
# env: STEER_NFT_COMPAT=legacy-min
# stderr: steer[info] apply: ядро без nat в семействе inet — правила собраны для nftables старого ядра: таблицы inet и ip
# stderr: steer[warn] apply: ядро не умеет nat для IPv6: запросы DNS клиентов по IPv6 идут мимо резолвера движка, и доменные каналы видят только тех, кто спрашивает по IPv4
table inet steer {
    set vpn_ip_c0 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = { 203.0.113.0/24 }
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
    }

    chain output_mark {
        type filter hook output priority mangle + 1; policy accept;
        meta skuid 10123 ct direction original ip daddr @vpn_ip_c0 meta mark set mark and 0xf03fffff or 0x00400000 ct mark set mark meta mark set mark or 0x00200000 counter return comment "steer:vpn_ip_c0"
    }

    chain postrouting_down {
        type filter hook postrouting priority srcnat + 10; policy accept;
    }
}
table ip steer {
    chain prerouting_nat {
        type nat hook prerouting priority dstnat - 1; policy accept;
        iifname "rndis0" udp dport 53 counter redirect to :5300
        iifname "rndis0" tcp dport 53 counter redirect to :5300
    }
    chain output_reroute {
        type route hook output priority mangle + 2; policy accept;
        meta mark and 0x00200000 == 0x00200000 meta mark set mark and 0xffdfffff counter comment "steer-reroute"
    }
    chain postrouting_nat {
        type nat hook postrouting priority srcnat + 1; policy accept;
    }
}
