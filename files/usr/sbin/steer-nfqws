#!/bin/sh
# Поднять обработчик обхода DPI для выхода kind=zapret.
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ СТРОКА В INIT-СКРИПТЕ. Ключи стратегии лежат в файле, и читать
# его надо В МОМЕНТ ЗАПУСКА ПРОЦЕССА, а не в момент описания экземпляра procd. Пока сборка
# аргументов стояла в init-скрипте, командная строка фиксировалась при `start_service` — то
# есть смена стратегии требовала перезапуска ВСЕГО движка вместе с туннелями, а сигнал
# экземпляру поднимал его с прежними ключами. Здесь же procd перезапускает эту обёртку, она
# читает файл заново, и «применить другую стратегию» становится одним сигналом.
#
# ПОЧЕМУ НЕ КЛЮЧ @файл САМОГО nfqws. У него такой ключ есть, но в его же справке сказано:
# «must be the only argument, other options are ignored». То есть с @файлом нельзя передать
# ни --qnum, ни --dpi-desync-fwmark, и номер очереди с битами меток пришлось бы вписывать в
# файл стратегии. Файл обязан оставаться СТРАТЕГИЕЙ: его пишет управляющий слой из каталога,
# и один и тот же файл должен годиться и выходу, и проверке на другой очереди.
#
#     steer-nfqws <номер очереди> <файл ключей>
set -u

QUEUE="${1:?нужен номер очереди}"
OPTS="${2:?нужен файл ключей}"
NFQWS="${NFQWS:-/opt/zapret/nfq/nfqws}"

case "$QUEUE" in ''|*[!0-9]*) echo "steer-nfqws: номер очереди — число, а не «$QUEUE»" >&2; exit 2 ;; esac

[ -x "$NFQWS" ] || {
    echo "steer-nfqws: нет $NFQWS — поставьте пакет zapret" >&2
    exit 2
}
[ -s "$OPTS" ] || {
    echo "steer-nfqws: файла стратегии $OPTS нет или он пуст" >&2
    exit 2
}

# Строка целиком становится ОДНИМ аргументом: значение с пробелом внутри (например
# --comment=) иначе развалилось бы на два. Строки с решёткой — комментарии; первая из них
# несёт имя стратегии, и по ней управляющий слой узнаёт, что применено (тот же приём, что у
# Zapret Manager).
#
# `|| [ -n "$line" ]` — НЕ УКРАШЕНИЕ. На последней строке без завершающего перевода `read`
# возвращает ненулевой код, УЖЕ ЗАПОЛНИВ переменную, и обычный `while read` теряет её молча.
# Файл ключей объявлен «просто файлом» и его правят руками по ssh, а последней строкой там
# обычно стоит сам способ обхода — то есть стратегия работала бы без главного своего ключа и
# выглядела бы применённой. Тот же капкан в проекте уже срабатывал дважды на чтении запроса
# ubus (sub_info и sub_quota в объекте rpcd splify2).
set --
line=''
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) line=''; continue ;; esac
    set -- "$@" "$line"
    line=''
done < "$OPTS"

[ "$#" -gt 0 ] || { echo "steer-nfqws: в $OPTS нет ни одного ключа" >&2; exit 2; }

# --dpi-desync-fwmark: чем обработчик метит СВОИ пакеты. Значение не наше — оно объяснено у
# ZAPRET_OWN_MARK в src/spec.h. Коротко: 0x40000000 снимает порождённые пакеты с учёта
# conntrack через цепочку predefrag самого zapret (без этого ядро отбрасывает их как
# INVALID) и уводит их от общего обхода, а 0x20000000 выводит их из нашей очереди.
#
# --user=daemon: тот же непривилегированный пользователь, под которым обход запускает свои
# экземпляры (WS_USER в /etc/config/zapret). Сокеты nfqws открывает до сброса прав.
exec "$NFQWS" --qnum="$QUEUE" --dpi-desync-fwmark=0x60000000 --user=daemon "$@"
