#!/bin/sh
# Событие сети → сторож выходов узнаёт о нём СРАЗУ, а не через минуту опроса.
#
# Сторож живёт в демоне (steerd daemon --watch), и смену интерфейса или адреса он слышит сам —
# по netlink. netifd, однако, знает больше ядра: ifup интерфейса протокола (wireguard, pppoe)
# означает «настроен и поднят», а не только «появилось устройство». Поэтому событие по-прежнему
# передаётся сторожу — сигналом SIGHUP экземпляру procd: демон перечитывает спеку и делает
# внеочередной проход (docs/ctl.md, «Сторож выходов»). Прежний проход `steer failover` отсюда
# ушёл: второй сторож рядом с демоном дрался бы с ним за одни таблицы выходов.
#
# ПОЧЕМУ ОПРОС ОСТАЁТСЯ. Интерфейс может быть жив, а туннель на той стороне мёртв — netifd тогда
# молчит, и заметить это можно только пробой. Событие ускоряет реакцию, а не заменяет сторожа.
[ "$ACTION" = ifup ] || [ "$ACTION" = ifdown ] || exit 0
[ -f /etc/steer/spec.json ] || exit 0
[ -x /usr/sbin/steerd ] || exit 0

# Замок каталогом: netifd поднимает интерфейсы пачкой (загрузка, `network restart`), и на пачку
# хватает одного сигнала. Просроченный замок снимаем сами: оставленный упавшим процессом, он
# иначе выключил бы реакцию на события навсегда.
LOCK=/var/lock/steer-hotplug
if [ -d "$LOCK" ] && [ -z "$(find "$LOCK" -maxdepth 0 -mmin -2 2>/dev/null)" ]; then
    rmdir "$LOCK" 2>/dev/null
fi
mkdir "$LOCK" 2>/dev/null || exit 0

(
    # Пауза: интерфейс, о котором пришло ifup, уже поднят, но маршрут по умолчанию и адрес могут
    # доехать мгновением позже; остальные события пачки за это время собираются под замком.
    sleep 2
    # Демона нет (сервис остановлен) — сторожить некому, и поднимать его отсюда не нужно.
    if ubus call service signal '{"name":"steer","instance":"steerd","signal":1}' 2>/dev/null; then
        logger -t steer-hotplug "событие $ACTION ${INTERFACE:-?} — сторожу внеочередной проход"
    fi
    rmdir "$LOCK" 2>/dev/null
) >/dev/null 2>&1 &
