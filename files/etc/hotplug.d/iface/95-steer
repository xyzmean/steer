#!/bin/sh
# Событие сети → сторож выходов узнаёт о нём СРАЗУ, а не через минуту опроса.
#
# ЗАЧЕМ. Единственным, кто замечал смену состояния сети, был цикл `while :; do steer
# failover; sleep 60; done` из init-скрипта. То есть после переключения WAN канал стоял до
# минуты, а на роутере, где всё в порядке, каждую минуту всё равно шла серия пингов с
# таймаутом три секунды на кандидата (I-137). netifd про подъём и падение интерфейсов знает
# точно и говорит об этом всем желающим — hotplug.d/iface и есть штатный способ услышать.
#
# ПОЧЕМУ ОПРОС ОСТАЁТСЯ. Событие покрывает не всё: интерфейс может быть жив, а туннель на
# той стороне мёртв — тогда netifd молчит, и заметить это можно только пробой. Поэтому
# событие ускоряет реакцию, а не заменяет сторожа.
#
# ПОЧЕМУ В ФОНЕ. Обработчики hotplug выполняются по очереди, и пинги кандидатов задержали бы
# обработку остальных событий на секунды. Отделяемся сразу; цена — процесс без присмотра
# procd, поэтому он ровно один (замок ниже) и живёт секунды.
[ "$ACTION" = ifup ] || [ "$ACTION" = ifdown ] || exit 0

SPEC=/etc/steer/spec.json
[ -f "$SPEC" ] || exit 0
[ -x /usr/sbin/steer ] || exit 0

# Замок каталогом: netifd поднимает интерфейсы пачкой (загрузка, `network restart`), и без
# него на каждое событие пачки уходил бы свой проход с пингами. Просроченный замок снимаем
# сами: оставленный упавшим процессом, он иначе выключил бы реакцию на события навсегда, и
# заметить это было бы нечем — опрос-то работает.
LOCK=/var/lock/steer-hotplug
if [ -d "$LOCK" ] && [ -z "$(find "$LOCK" -maxdepth 0 -mmin -2 2>/dev/null)" ]; then
    rmdir "$LOCK" 2>/dev/null
fi
mkdir "$LOCK" 2>/dev/null || exit 0

(
    # Пауза перед проходом: интерфейс, о котором пришло ifup, к моменту события уже поднят,
    # но маршрут по умолчанию и адрес могут доехать мгновением позже — проход, сделанный
    # раньше них, увидел бы прежнее состояние и переключил бы выход зря.
    sleep 2
    # Одна строка на ПРОХОД, а не на событие: событий в пачке бывает пять, проход из них
    # один (замок), и журнал должен показывать сделанное, а не полученное. Сам сторож
    # печатает только изменения — молчаливый проход это «всё на месте», и отличить его от
    # «скрипт не запускался» иначе нечем.
    logger -t steer-hotplug "событие $ACTION ${INTERFACE:-?} — прохожу сторожем"
    /usr/sbin/steer failover --spec "$SPEC" 2>&1 | logger -t steer-hotplug
    rmdir "$LOCK" 2>/dev/null
) >/dev/null 2>&1 &
