#!/bin/sh /etc/rc.common
# Applies the ruleset at boot and runs the resolver for domain channels.
#
# START is after the network is up (the routing tables an interface output needs
# want their device to exist) but before anything that carries user traffic, so a
# client never gets a moment of unsteered routing after a reboot.
START=94
STOP=11
USE_PROCD=1
EXTRA_COMMANDS="reload_dnsd reload_zapret reapply"
EXTRA_HELP="	reload_zapret	Перечитать стратегии обхода, не трогая туннели
	reload_dnsd	Перезапустить только резолвер, не снимая правил
	reapply		Пересобрать и применить правила, не трогая резолвер"

SPEC=/etc/steer/spec.json
# Как часто проверять устройства. Пинг с таймаутом 3с на кандидата, так что минута
# — это заметно меньше процента времени коробки даже на самой слабой.
FAILOVER_INTERVAL=60
# Как часто освежать снимок состояния (`steer status`, см. комментарий про снимок в
# src/steer.c). Пять минут — это компромисс между двумя ценами, и обе замерены на стенде
# (mipsel 24kc, 880 МГц): полный ответ стоит 91 мс, то есть чаще платить незачем, а реже —
# значит показать человеку, открывшему страницу, состояние получасовой давности.
#
# Зачем это вообще нужно, если снимок обновляет и каждый круг опроса открытой страницы:
# ровно затем, чтобы к моменту ОТКРЫТИЯ окна снимок уже был, причём свежий. Пока страницу
# никто не смотрит, обновлять его больше некому.
#
# Флеш от этого не страдает: снимок ложится в каталог состояния (/var/lib/steer), а /var на
# OpenWrt — символическая ссылка на /tmp, то есть tmpfs. Там же и по той же причине живут
# запись активного устройства и записи перебора узлов, которые сторож переписывает раз в
# минуту.
STATUS_INTERVAL=300

boot() {
    # `nft -f` needs the firewall's own tables to exist first; on a cold boot
    # fw4 may still be starting. The apply below is idempotent, and the procd
    # instance retries it anyway, so a lost race costs nothing.
    start "$@"
}

start_service() {
    [ -f "$SPEC" ] || { echo "steer: no $SPEC — nothing to apply"; return 0; }

    # Выходы kind=vless поднимаются ПЕРЕД apply: их TUN-устройства должны существовать к
    # моменту, когда apply будет привязывать к ним таблицы маршрутизации. Иначе первый
    # apply не находит устройство, ставит blackhole (при on_fail=drop), и трафик стоит до
    # следующего тика сторожа — то есть до минуты после каждого перезапуска.
    vless_outs="$(steer outputs --kind vless --spec "$SPEC" 2>/dev/null)"
    for out in $vless_outs; do
        procd_open_instance "vless_$out"
        procd_set_param command /usr/sbin/steer vless "$out" --spec "$SPEC"
        # Счётчики цикла включаются файлом-признаком, а не пересборкой: когда скорость
        # «не такая», спорить о причинах бесполезно — нужны числа с ЖИВОГО трафика.
        # `touch /etc/steer/stats`, перезапуск, `logread | grep tun-stats`.
        [ -f /etc/steer/stats ] && procd_set_param env STEER_TUN_STATS=1
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    done

    # Выходы kind=xsteer — тем же порядком и по той же причине, что vless: устройство
    # создаёт сам процесс туннеля, и к моменту apply оно должно существовать, иначе выход
    # уходит в blackhole до следующего тика сторожа. Отдельным циклом, а не общим с vless:
    # команда у них разная (`steer xsteer` против `steer vless`), и склеивать их значило бы
    # выбирать команду по виду выхода внутри цикла — то есть держать тот же перебор, только
    # спрятанным.
    #
    # Транспорт (поддельный TCP или поток) процесс берёт из самой спеки, поэтому ключей
    # здесь нет: procd передать их некуда, а настройка обязана переживать перезагрузку.
    xs_outs="$(steer outputs --kind xsteer --spec "$SPEC" 2>/dev/null)"
    for out in $xs_outs; do
        procd_open_instance "xsteer_$out"
        procd_set_param command /usr/sbin/steer xsteer "$out" --spec "$SPEC"
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    done

    # Обфускаторы — тоже ПЕРЕД apply, но по другой причине, чем vless. Устройство у
    # выхода с obfs создаёт netifd, оно уже есть; а вот WireGuard начинает слать
    # рукопожатия сразу после подъёма, и если процесса, слушающего его Endpoint, ещё
    # нет, первые попытки уходят в закрытый порт. Стоит это не отказа, а задержки в
    # несколько секунд на каждом старте — но задержки видимой: туннель «долго
    # поднимается» без единой строчки в журнале о причине.
    #
    # Список спрашиваем у движка (steer outputs --obfs), а не grep по спеке — тот же
    # урок, что с needs-dnsd: поиск литерала в JSON ломается при первом переименовании
    # поля, причём молча.
    obfs_outs="$(steer outputs --obfs --spec "$SPEC" 2>/dev/null)"
    for out in $obfs_outs; do
        procd_open_instance "obfs_$out"
        procd_set_param command /usr/sbin/steer obfs "$out" --spec "$SPEC"
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    done

    # Обработчики выходов kind=zapret — по одному на выход. Тоже ПЕРЕД apply, и причина
    # ровно та же, что у обфускаторов, только жёстче: при on_fail=drop (умолчание) правило
    # очереди стоит БЕЗ `bypass`, то есть пока процесса на очереди нет, помеченный трафик
    # отбрасывается ядром. Поднять их позже правил значило бы гарантированную дырку в
    # несколько секунд на каждом старте.
    #
    # Список спрашиваем у движка (steer zapret-instances), а не собираем из спеки: он же
    # печатает номер очереди, потому что выводит его из метки выхода. Повторять этот вывод
    # здесь значило бы завести второй источник правды о том, какой процесс какой трафик
    # разбирает, — и расхождение выглядело бы как «стратегия применилась и не действует».
    #
    # КЛЮЧИ ЧИТАЕТ ОБЁРТКА /usr/sbin/steer-nfqws, а не этот скрипт, и это не косметика:
    # описание экземпляра procd фиксируется в момент start_service, поэтому собранная здесь
    # командная строка означала бы, что смена стратегии требует перезапуска ВСЕГО движка
    # вместе с туннелями, а сигнал экземпляру поднимает его с прежними ключами. Обёртка
    # читает файл при каждом своём запуске — значит `reload_zapret` ниже достаточно.
    #
    # БЕЗ КОНВЕЙЕРА, и это не стиль. `... | while read` в ash исполняет тело в ПОДОБОЛОЧКЕ, а
    # procd_open_instance накапливает описание экземпляра в переменных оболочки: из
    # подоболочки оно не возвращается никуда, и результат — ни одного поднятого обработчика
    # при полностью исправном на вид скрипте. Поэтому строки перебираются подстановкой с
    # IFS, а поля режутся сокращением строки.
    zp="$(steer zapret-instances --spec "$SPEC" 2>/dev/null)"
    if [ -n "$zp" ]; then
        zp_ifs="$IFS"
        zp_tab="$(printf '\t')"
        IFS='
'
        for zrow in $zp; do
            IFS="$zp_ifs"
            zname="${zrow%%${zp_tab}*}"
            zrest="${zrow#*${zp_tab}}"
            zqueue="${zrest%%${zp_tab}*}"
            zopts="${zrest#*${zp_tab}}"
            if [ -n "$zname" ] && [ -n "$zqueue" ]; then
                procd_open_instance "zapret_$zname"
                procd_set_param command /usr/sbin/steer-nfqws "$zqueue" "$zopts"
                procd_set_param respawn 3600 5 0
                procd_set_param stdout 1
                procd_set_param stderr 1
                procd_close_instance
            fi
            IFS='
'
        done
        IFS="$zp_ifs"
    fi

    # Мосты выходов kind=tgws — по одному на выход, и тоже ПЕРЕД apply. Причина та же, что у
    # обработчиков обхода: правило перехвата стоит в ядре безусловно, и пока моста нет, ядро
    # отвечает на перехваченное соединение отказом. Поднять мост позже правил значило бы
    # несколько секунд «Telegram не соединяется» на каждом старте.
    #
    # Порт печатает движок (steer tgws-instances) по той же причине, что номер очереди у
    # zapret: второй расчёт того же здесь разошёлся бы молча, и мост слушал бы порт, на
    # который ядро ничего не заворачивает.
    #
    # Без конвейера — та же ловушка подоболочки, что расписана выше.
    tg="$(steer tgws-instances --spec "$SPEC" 2>/dev/null)"
    if [ -n "$tg" ]; then
        tg_ifs="$IFS"
        tg_tab="$(printf '\t')"
        IFS='
'
        for trow in $tg; do
            IFS="$tg_ifs"
            tname="${trow%%${tg_tab}*}"
            tport="${trow#*${tg_tab}}"
            if [ -n "$tname" ] && [ -n "$tport" ]; then
                procd_open_instance "tgws_$tname"
                procd_set_param command /usr/sbin/steer tgws "$tname" --spec "$SPEC"
                procd_set_param respawn 3600 5 0
                procd_set_param stdout 1
                procd_set_param stderr 1
                procd_close_instance
            fi
            IFS='
'
        done
        IFS="$tg_ifs"
    fi

    # Ждать здесь появления устройства НЕЛЬЗЯ, и это не осторожность, а свойство procd:
    # procd_open_instance только описывает экземпляр, а запускает его procd после возврата
    # из start_service. Внутри этой функции процесса ещё нет, поэтому ожидание устройства
    # гарантированно истекло бы впустую — проверено, ждало двадцать секунд и не дождалось.
    #
    # Поэтому таблицу маршрутизации к своему устройству привязывает сам процесс vless,
    # когда устройство создано и поднято: он единственный, кто знает этот момент. Здешний
    # apply до тех пор держит на выходе запрет (при on_fail=drop) — и это правильно: пока
    # туннеля нет, трафику там делать нечего.
    steer apply --spec "$SPEC" || echo "steer: apply failed — see the message above"

    # Сторож туннелей отдельным экземпляром. Не демон внутри движка: движок остаётся
    # компилятором, а «раз в минуту» — дело того, кто его вызывает. Отдельный
    # экземпляр к тому же переживает падение резолвера и наоборот.
    #
    # Запускается всегда, даже без доменных каналов: следить за устройствами нужно
    # и адресным выходам.
    #
    # Порядок здесь — не оформление. Этот блок стоял НИЖЕ вопроса про резолвер, а тот
    # выходит из функции при ответе «доменных каналов нет». Обычная конфигурация
    # «блоклист по адресам в туннель» доменов не содержит — и оставалась вовсе без
    # сторожа: переключения между devices не происходили никогда, а при on_fail=drop
    # (умолчание) apply ставит запрет, если устройства нет в момент применения, и снять
    # его было некому — канал стоял намертво до ручного перезапуска.
    procd_open_instance failover
    procd_set_param command /bin/sh -c \
        "while :; do /usr/sbin/steer failover --spec '$SPEC'; sleep ${FAILOVER_INTERVAL:-60}; done"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Снимок состояния — отдельным экземпляром, а не вторым делом внутри сторожа.
    #
    # Причина та же, по которой сторож не живёт демоном внутри движка: движок остаётся
    # компилятором, а «раз в пять минут» — дело того, кто его вызывает. Плюс отдельный
    # экземпляр переживает падение сторожа и наоборот, и его видно в `service steer status`
    # под своим именем: работа, которой не видно, однажды оказывается неработающей.
    #
    # Вывод в /dev/null нарочно: снимок — это ПОБОЧНОЕ действие полного `status`, а сам ответ
    # здесь никому не адресован, и сваливать его в системный журнал каждые пять минут значило
    # бы забить журнал состоянием, которое никто не просил.
    procd_open_instance status
    procd_set_param command /bin/sh -c \
        "while :; do /usr/sbin/steer status --spec '$SPEC' >/dev/null 2>&1; sleep ${STATUS_INTERVAL:-300}; done"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Ask the ENGINE whether the resolver is needed. Never grep the spec for a
    # literal key: this line used to look for `"domains_file"`, the spec gained the
    # plural `domains_files`, and the match quietly stopped working — the resolver
    # did not start while apply still installed the DNS redirect, so every LAN
    # query went to a closed port and DNS died with nothing in the log to say why.
    steer needs-dnsd --spec "$SPEC" || return 0

    # Экземпляр НАЗВАН, а не безымянный: reload_dnsd должен уметь послать сигнал ровно
    # ему. Без имени приходилось сигналить '*', то есть всем экземплярам сразу — включая
    # процессы vless. Каждое «Сохранить и применить» из интерфейса убивало туннель, procd
    # поднимал его заново через паузу, и трафик пропадал на секунды после каждой правки.
    procd_open_instance dnsd
    # Абсолютный путь: команду экземпляра запускает procd, а не эта оболочка, и его
    # PATH — не наш. Голое имя работало только там, где сервис поднимали из шелла.
    procd_set_param command /usr/sbin/steer dnsd --spec "$SPEC"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param reload_signal HUP
    procd_close_instance
}

# The ruleset lives in its own table, so cleanup cannot damage anyone else's
# firewall — which is the whole reason for not being an fw4 include.
stop_service() {
    nft delete table inet steer 2>/dev/null
    # Правила обфускаторов живут в СВОЕЙ таблице: ту, что выше, apply пересобирает
    # целиком при каждом сохранении настроек, и правило против RST исчезало бы вместе
    # с ней. Свои цепочки процессы снимают сами при выходе — эта строка на случай, когда
    # выхода не было (SIGKILL, паника, снятие питания).
    nft delete table inet steer_obfs 2>/dev/null
    for t in $(awk '{print $3}' /var/lib/steer/registry 2>/dev/null); do
        ip route flush table "$t" 2>/dev/null
    done
    # Правило снимается В ОБЕИХ ФОРМАХ: с маской (как ставит движок с R-094) и прежнюю
    # без неё — она осталась в ядре, если пакет обновили, а сервис с тех пор не
    # перезапускали. Маска здесь литералом, а не из движка: init-скрипт зовут и тогда,
    # когда бинарника уже нет (удаление пакета), а число объявлено в контракте
    # (docs/contract-v1.md, STEER_MARK_MASK в src/spec.h) и меняться не должно.
    for m in $(awk '{print $2}' /var/lib/steer/registry 2>/dev/null); do
        while ip rule del fwmark "0x$m/0x0ff00000" 2>/dev/null; do :; done
        while ip rule del fwmark "0x$m" 2>/dev/null; do :; done
    done
}

# Какие файлы у доменного канала — читается из спеки при СТАРТЕ, поэтому HUP
# недостаточно: он перечитывает сами файлы, но не список файлов. Канал, которому
# добавили список, после HUP продолжает матчить прежние домены — а правила и наборы
# при этом уже новые, и расхождение выглядит как "список выбран, но не работает".
#
# Правила не снимаются: apply их уже поставил, а перезапуск только экземпляра резолвера
# оставляет маршрутизацию на месте. Состояние fake-IP переживает перезапуск (оно на
# диске), так что это дёшево.
reload_dnsd() {
    # Сигнал уходить некому, если экземпляра нет — а его нет в самом обычном случае:
    # пакет поставили без спеки (start_service тогда выходит раньше procd_open_instance),
    # затем настроили через интерфейс, и apply поставил правила напрямую. Тогда
    # маршрутизация работает, а резолвер не запущен — и fake-IP "не заводится" без
    # единой ошибки. Поэтому: нет экземпляра — поднимаем сервис, а не сигналим.
    #
    # Сигнал уходит ИМЕННО резолверу. Раньше здесь стояло '*' — то есть все экземпляры, в
    # том числе клиенты vless и сторож. Каждое «Сохранить и применить» из интерфейса
    # убивало туннель, procd поднимал его заново с паузой, и трафик через vless пропадал
    # на несколько секунд после каждой правки списка. Подписка при этом перечитывалась
    # заново и узел мог оказаться другим — то есть правка списка меняла ещё и выходной
    # адрес, чего никто не просил.
    if ubus call service list "{\"name\":\"steer\"}" 2>/dev/null | grep -q '"dnsd"'; then
        procd_send_signal steer dnsd TERM 2>/dev/null
    else
        start
    fi
}

# Перечитать стратегии обхода — и только их.
#
# ЗАЧЕМ ОТДЕЛЬНАЯ КОМАНДА. Смена стратегии у выхода kind=zapret — это правка одного файла, а
# единственным способом её применить был бы `restart` всего движка: он снимает правила,
# роняет клиенты vless и поднимает туннели заново, то есть каждая проба другой стратегии
# стоила бы человеку нескольких секунд без интернета. Ровно тот же довод, по которому рядом
# живёт reload_dnsd, и ровно та же ошибка, что там уже была исправлена: сигнал '*' уходил
# всем экземплярам сразу, включая туннели.
#
# Сигнал уходит ИМЕНОВАННЫМ экземплярам обхода. procd поднимает их заново, обёртка
# steer-nfqws читает файл стратегии при запуске — и новые ключи оказываются в работе, не
# задев ничего вокруг.
#
# Экземпляров может не быть вовсе (пакет zapret не установлен, выходов такого вида нет) —
# это законно и молча: команду зовёт интерфейс после каждой смены стратегии, в том числе
# когда менялась стратегия всего роутера, а не выхода.
reload_zapret() {
    for _z in $(ubus call service list "{\"name\":\"steer\"}" 2>/dev/null |
                grep -o '"zapret_[a-zA-Z0-9_.-]*"' | tr -d '"'); do
        procd_send_signal steer "$_z" TERM 2>/dev/null
    done
    return 0
}

reload_service() {
    steer apply --spec "$SPEC"
    reload_dnsd
}

# Пересобрать и применить правила — и только это. Нужна триггеру ниже: смена настройки
# сети может сдвинуть lan_device и подсети клиентов (from_default читается из адреса
# lan_device), то есть ruleset обязан быть перегенерирован. Полный `reload` для этого не
# годится: он вдобавок перезапускает резолвер, а это провал DNS на секунды — за настройку,
# которая резолвера не касается.
reapply() {
    [ -f "$SPEC" ] || return 0
    steer apply --spec "$SPEC" || echo "steer: apply failed — see the message above"
}

service_triggers() {
    # Прежде здесь стояло `procd_add_reload_trigger "steer"` — подписка на изменение
    # /etc/config/steer. Такого файла пакет не кладёт и никто не создаёт: настройка живёт в
    # /etc/steer/spec.json. То есть триггер не срабатывал ни разу за всю историю, а
    # выглядел работающим механизмом (I-137).
    #
    # Настоящая подписка — на /etc/config/network: он меняется, когда правят интерфейсы и
    # мост локальной сети, а из адреса lan_device выводятся подсети клиентов. Команда узкая
    # (reapply, а не reload) по причине, записанной у неё же.
    #
    # Подъём и падение интерфейсов приходят не сюда, а в /etc/hotplug.d/iface/95-steer:
    # событие «интерфейс поднялся» это не изменение настройки, и обрабатывать его перезапуском
    # правил незачем — там нужен проход сторожа.
    procd_open_trigger
    procd_add_config_trigger "config.change" "network" /etc/init.d/steer reapply
    procd_close_trigger
}
