#!/bin/sh /etc/rc.common
# Applies the ruleset at boot and runs the resolver for domain channels.
#
# START is after the network is up (the routing tables an interface output needs
# want their device to exist) but before anything that carries user traffic, so a
# client never gets a moment of unsteered routing after a reboot.
START=94
STOP=11
USE_PROCD=1
EXTRA_COMMANDS="reload_dnsd"
EXTRA_HELP="	reload_dnsd	Перезапустить только резолвер, не снимая правил"

SPEC=/etc/steer/spec.json
# Как часто проверять устройства. Пинг с таймаутом 3с на кандидата, так что минута
# — это заметно меньше процента времени коробки даже на самой слабой.
FAILOVER_INTERVAL=60

boot() {
    # `nft -f` needs the firewall's own tables to exist first; on a cold boot
    # fw4 may still be starting. The apply below is idempotent, and the procd
    # instance retries it anyway, so a lost race costs nothing.
    start "$@"
}

start_service() {
    [ -f "$SPEC" ] || { echo "steer: no $SPEC — nothing to apply"; return 0; }

    steer apply --spec "$SPEC" || echo "steer: apply failed — see the message above"

    # Ask the ENGINE whether the resolver is needed. Never grep the spec for a
    # literal key: this line used to look for `"domains_file"`, the spec gained the
    # plural `domains_files`, and the match quietly stopped working — the resolver
    # did not start while apply still installed the DNS redirect, so every LAN
    # query went to a closed port and DNS died with nothing in the log to say why.
    steer needs-dnsd --spec "$SPEC" || return 0

    # Сторож туннелей отдельным экземпляром. Не демон внутри движка: движок остаётся
    # компилятором, а «раз в минуту» — дело того, кто его вызывает. Отдельный
    # экземпляр к тому же переживает падение резолвера и наоборот.
    #
    # Запускается всегда, даже без доменных каналов: следить за устройствами нужно
    # и адресным выходам.
    procd_open_instance failover
    procd_set_param command /bin/sh -c \
        "while :; do /usr/sbin/steer failover --spec '$SPEC'; sleep ${FAILOVER_INTERVAL:-60}; done"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance
    # Абсолютный путь: команду экземпляра запускает procd, а не эта оболочка, и его
    # PATH — не наш. Голое имя работало только там, где сервис поднимали из шелла.
    procd_set_param command /usr/sbin/steer dnsd --spec "$SPEC"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param reload_signal HUP
    procd_close_instance
}

# The ruleset lives in its own table, so cleanup cannot damage anyone else's
# firewall — which is the whole reason for not being an fw4 include.
stop_service() {
    nft delete table inet steer 2>/dev/null
    for t in $(awk '{print $3}' /var/lib/steer/registry 2>/dev/null); do
        ip route flush table "$t" 2>/dev/null
    done
    for m in $(awk '{print $2}' /var/lib/steer/registry 2>/dev/null); do
        while ip rule del fwmark "0x$m" 2>/dev/null; do :; done
    done
}

# Какие файлы у доменного канала — читается из спеки при СТАРТЕ, поэтому HUP
# недостаточно: он перечитывает сами файлы, но не список файлов. Канал, которому
# добавили список, после HUP продолжает матчить прежние домены — а правила и наборы
# при этом уже новые, и расхождение выглядит как "список выбран, но не работает".
#
# Правила не снимаются: apply их уже поставил, а перезапуск только экземпляра резолвера
# оставляет маршрутизацию на месте. Состояние fake-IP переживает перезапуск (оно на
# диске), так что это дёшево.
reload_dnsd() {
    # Сигнал уходить некому, если экземпляра нет — а его нет в самом обычном случае:
    # пакет поставили без спеки (start_service тогда выходит раньше procd_open_instance),
    # затем настроили через интерфейс, и apply поставил правила напрямую. Тогда
    # маршрутизация работает, а резолвер не запущен — и fake-IP "не заводится" без
    # единой ошибки. Поэтому: нет экземпляра — поднимаем сервис, а не сигналим.
    if ubus call service list "{\"name\":\"steer\"}" 2>/dev/null | grep -q instances; then
        procd_send_signal steer '*' TERM 2>/dev/null
    else
        start
    fi
}

reload_service() {
    steer apply --spec "$SPEC"
    reload_dnsd
}

service_triggers() {
    procd_add_reload_trigger "steer"
}
