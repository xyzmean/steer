#!/bin/sh /etc/rc.common
# Движок steer: один процесс — демон steerd (docs/architecture.md, раздел 4а).
#
# Всё, что прежде жило здесь циклами и экземплярами procd, — теперь демон: применение спеки при
# старте (--apply), сторож выходов (--watch, вместо `while :; do steer failover; sleep 60; done`),
# помощники выходов и резолвер (--supervise, вместо экземпляров vless_*, xsteer_*, obfs_*,
# zapret_*, tgws_* и dnsd), освежение снимка status раз в пять минут. procd держит один
# экземпляр с respawn; reload — запрос в сокет демона клиентом `steer reload`: демон сверяет
# спеку с применённой и трогает только изменившееся (набор правил, маршрутизацию выходов,
# помощников, таблицу резолвера).
#
# START — после подъёма сети (таблицам маршрутизации выходов нужно их устройство), но раньше
# всего, что несёт трафик клиентов: после перезагрузки у клиента не должно быть мгновения без
# маршрутизации по правилам.
START=94
STOP=11
USE_PROCD=1
# Прежние имена остаются: их зовут splify2 (reload_dnsd, reload_zapret) и триггер сети (reapply).
# Все три теперь значат одно — «демон, перечитай спеку»: что именно трогать, решает сверка.
EXTRA_COMMANDS="reload_dnsd reload_zapret reapply"
EXTRA_HELP="	reload_zapret	Перечитать стратегии обхода, не трогая туннели
	reload_dnsd	Перечитать списки резолвером, не снимая правил
	reapply		Пересобрать и применить правила, не трогая остального"

SPEC=/etc/steer/spec.json
# Абсолютные пути: команду экземпляра запускает procd, а не эта оболочка, и его PATH — не наш.
STEERD=/usr/sbin/steerd
STEER=/usr/sbin/steer

boot() {
    # `nft -f` нужны собственные таблицы fw4; на холодной загрузке он может ещё подниматься.
    # Применение при старте демона идемпотентно, а respawn procd повторит его при сбое.
    start "$@"
}

start_service() {
    # Без спеки демон тоже нужен: splify2 кладёт спеку и зовёт `steer apply`, и клиент отдаёт
    # её демону — тот сохраняет, применяет и поднимает помощников. Демон без спеки отвечает
    # status тем же отказом, что движок, и ничего не применяет.
    procd_open_instance steerd
    procd_set_param command "$STEERD" daemon --watch --supervise --apply --spec "$SPEC"
    procd_set_param respawn 3600 5 0
    # SIGTERM демону гасит помощников по одному (3 с каждому, 10 с всем) — procd не должен убить
    # его SIGKILL раньше, иначе помощники остались бы без присмотра.
    procd_set_param term_timeout 15
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# Правила снимает steerd down — после того, как демон вышел: пока он жив, сторож мог бы
# привязать таблицу выхода заново посреди снятия. procd гасит экземпляр после stop_service
# (procd_kill), поэтому здесь запоминается pid, а ждать и снимать — в service_stopped.
stop_service() {
    _steerd_pid="$(ubus call service list '{"name":"steer"}' 2>/dev/null |
                   jsonfilter -e '@.steer.instances.steerd.pid' 2>/dev/null)"
}

service_stopped() {
    _i=0
    while [ -n "${_steerd_pid:-}" ] && [ -d "/proc/$_steerd_pid" ] && [ $_i -lt 20 ]; do
        sleep 1
        _i=$((_i + 1))
    done
    if [ -x "$STEERD" ]; then
        "$STEERD" down
        return 0
    fi
    # Бинарника уже нет (удаление пакета): то же, что делает down, литералами. Таблицы движка
    # живут отдельно от fw4, поэтому снятие не задевает чужой firewall; маска метки объявлена
    # в контракте (docs/contract-v1.md) и меняться не должна.
    for t in "inet steer" "ip steer" "ip6 steer" "inet steer_obfs"; do
        nft delete table $t 2>/dev/null
    done
    for t in $(awk '{print $3}' /var/lib/steer/registry 2>/dev/null); do
        ip route flush table "$t" 2>/dev/null
    done
    for m in $(awk '{print $2}' /var/lib/steer/registry 2>/dev/null); do
        while ip rule del fwmark "0x$m/0x0ff00000" 2>/dev/null; do :; done
        while ip rule del fwmark "0x$m" 2>/dev/null; do :; done
    done
}

# Снят ли автозапуск: ссылка в /etc/rc.d — это и есть запись человеческого решения «не
# поднимать» («Остановить всё» в splify2 делает stop и disable).
steer_autostart_off() {
    [ -d /etc/rc.d ] || return 1        # не OpenWrt-подобная система — не гадаем
    set -- /etc/rc.d/S[0-9][0-9]steer
    [ -e "$1" ] && return 1
    return 0
}

# Запрос reload демону. Код 3 у клиента — демон не отвечает (не запущен); тогда 1, и решает
# вызывающий. Отказ самого reload (спека не прошла проверку) демон уже описал в stderr.
steer_reload() {
    "$STEER" reload --spec "$SPEC"
    [ $? -ne 3 ]
}

# Перечитать списки резолвером. Зовут его splify2 после «Применить» и ночное обновление списков
# — как «перечитай, если работаешь». Демон отдаёт резолверу новую таблицу, только если
# изменились она сама или файлы её списков, и процесс резолвера тот же: DNS не пропадает.
reload_dnsd() {
    steer_reload && return 0
    if steer_autostart_off; then
        # Человек выключил движок — и это сильнее: ночное обновление списков не должно
        # поднимать его молча.
        echo "steer: автозапуск снят — движок не поднимаю"
        return 0
    fi
    start
}

# Перечитать стратегии обхода: содержимое файла стратегии входит в подпись обработчика, и
# сверка перезапускает обработчик только того выхода, чья стратегия сменилась. Демона нет —
# перезапускать нечего, и это законно: команду зовут после каждой смены стратегии.
reload_zapret() {
    steer_reload
    return 0
}

reload_service() {
    steer_reload && return 0
    steer_autostart_off || start
}

# Пересобрать правила после смены настройки сети (триггер ниже): подсети клиентов выводятся из
# адреса lan_device, и набор правил меняется, хотя спека та же — сверка это увидит. Демона нет —
# применить движком, как прежде.
reapply() {
    [ -f "$SPEC" ] || return 0
    steer_reload && return 0
    "$STEERD" apply --spec "$SPEC" || echo "steer: apply failed — see the message above"
}

service_triggers() {
    # Подписка на /etc/config/network: он меняется, когда правят интерфейсы и мост локальной
    # сети. Подъём и падение интерфейсов приходят не сюда, а в /etc/hotplug.d/iface/95-steer.
    procd_open_trigger
    procd_add_config_trigger "config.change" "network" /etc/init.d/steer reapply
    procd_close_trigger
}
