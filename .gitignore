# Артефакты сборки — но НЕ каталог build целиком: в нём живут Dockerfile и
# build-ext.sh, без которых `./build.sh` из свежего клона не работает. Строка
# `build/` их и прятала: сборка собиралась только там, где эти файлы уже лежали
# на диске, то есть у одного человека.
build/steer
build/steer-*
build/libmbed-*.a
build/*.err
build/pkg/
build/scripts/
out/
build/sing-box
build/bench-*
build/cstorm-*
build/hget-*
build/res-*
build/tmo-*
build/tun-gso-*
build/gcm-size
build/bench
build/dnsmatch
build/specmatch
build/failovermatch
build/h2match
build/submatch
build/fwmatch
build/obfsmatch
build/visionmatch
build/specmatch-ext
build/xswirematch
build/xsconfmatch
build/xsroutematch
build/chellomatch
build/hellofreeze
build/xsloop
build/xsbench
build/steer-hub
build/steer-ext
build/transportcost
# Родной скрипт OpenWrt, качается сборкой при первом запуске (см. build.sh).
build/ipkg-build
# Дерево архива серверной половины: собирается из build/steer-<арх> и server/.
build/obfs-*
build/diagsim
build/crypto-vec
build/bx-*
