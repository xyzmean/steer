# Артефакты сборки — но НЕ каталог build целиком: в нём живут Dockerfile и
# build-ext.sh, без которых `./build.sh` из свежего клона не работает. Строка
# `build/` их и прятала: сборка собиралась только там, где эти файлы уже лежали
# на диске, то есть у одного человека.
build/steer
build/steer-*
build/libmbed-*.a
build/*.err
build/pkg/
build/scripts/
out/
build/sing-box
build/bench-*
build/cstorm-*
build/hget-*
build/res-*
build/tmo-*
build/tun-gso-*
build/gcm-size
# Собранные стенды `make test`, которым Makefile велит лежать в build/. Один из них
# (build/dcmatch) однажды уехал в репозиторий вместе с правкой моста и с тех пор
# менялся в каждом коммите, который трогал tgws.c: собранный файл в истории — это
# бинарный дифф на ровном месте и лишний повод для конфликта (I-237).
build/dcmatch
build/msgsplitmatch
build/warmmatch
build/upmatch
build/bench
build/dnsmatch
build/specmatch
build/failovermatch
build/h2match
build/submatch
build/subfetchmatch
build/fwmatch
build/obfsmatch
build/visionmatch
build/specmatch-ext
build/xswirematch
build/xsstreammatch
build/xsepochmatch
build/tungromatch
build/tunnamematch
build/xsconfmatch
build/xsroutematch
build/chellomatch
build/hellofreeze
build/xsloop
build/spokematch
build/hubmatch
build/xsbench
build/steer-hub
build/steer-ext
build/transportcost
# Родной скрипт OpenWrt, качается сборкой при первом запуске (см. build.sh).
build/ipkg-build
# Дерево архива серверной половины: собирается из build/steer-<арх> и server/.
build/obfs-*
build/diagsim
build/crypto-vec
build/bx-*
# Объекты mbedtls, собранные под хост для прогона стендов src/ext в образе
build/mbedtls-host/
build/asan-probe*
build/devupmatch
build/vlessmatch
build/stgws-*
build/msgsplitmatch
build/hwidsum
build/warmmatch
